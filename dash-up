#!/usr/bin/env bash
# dash-up <dashboard-config.yaml> [docker compose subcommand + args...]
#
# Bring up the vehicle dashboard (remote-api sidecar + static web server) from ONE config.
# rig invokes:  dash-up <config> <verb>   (verbs mapped in rigging.yaml; e.g. up -> "up -d").
# The repo does NOT depend on rig; rig depends on this launcher + rigging.yaml (one-way).
#
#   dash-up config/infra/dashboard.example.yaml up -d        # detached
#   dash-up /any/host/path/dashboard.yaml up -d        # arbitrary config path (rig supplies it)
#   dash-up config/infra/dashboard.example.yaml down
#   dash-up config/infra/dashboard.example.yaml ps
#   dash-up config/infra/dashboard.example.yaml logs
#   dash-up config/infra/dashboard.example.yaml config       # render the merged compose
#
# Registry (pull-based) deploy: set DASH_REGISTRY (or rig's RIG_IMAGE_REGISTRY); run `pull` then `up -d`.
# Images resolve to <registry>/<name>:<tag> (dashboard-zenoh + dashboard-web, plus dashboard-rig-agent
# when `rig_agent: true` — all built by tools/build-images.sh). Per-image vars (DASH_ZENOH_IMAGE /
# DASH_WEB_IMAGE / DASH_AGENT_IMAGE) override individually.
# Stdout stays clean (status line -> stderr) so `ps --format json` parses.
set -euo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
PYTHON="${DASH_PYTHON:-python3}"
COMPOSE="$REPO/deploy/docker-compose.yml"

CONFIG="${1:?usage: dash-up <dashboard-config.yaml> [compose args...]}"; shift || true
# Accept the config as given (abs / cwd-relative -- e.g. a rig-supplied vehicle path), or fall back to
# the repo-relative short form so `dash-up config/infra/dashboard.example.yaml` works anywhere.
if [ ! -f "$CONFIG" ] && [ -f "$REPO/$CONFIG" ]; then CONFIG="$REPO/$CONFIG"; fi
[ -f "$CONFIG" ] || { echo "dash-up: config not found: $CONFIG" >&2; exit 1; }
CONFIG_ABS="$(cd "$(dirname "$CONFIG")" && pwd)/$(basename "$CONFIG")"

docker compose version >/dev/null 2>&1 || { echo "dash-up: needs the Docker Compose v2 plugin ('docker compose')" >&2; exit 1; }

# config -> env (instance name + host ports). Simple tokens, no spaces.
eval "$("$PYTHON" "$REPO/tools/dash_env.py" "$CONFIG_ABS" | sed 's/^/export /')"
# The SAME config file is bind-mounted into dashboard-web (docker-compose.external-config.yml) and
# served at /config/dashboard.yaml — the app reads its `home:` block + ws_port at load.
export DASH_CONFIG_HOST="$CONFIG_ABS"
# rig owns the compose project (<name>-vehicle-<id>) and exports COMPOSE_PROJECT_NAME per call; honor
# it so rig/bake/the launcher all manage ONE project. The instance name is the standalone fallback.
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-${DASH_NAME:-dashboard}}"

# Registry deploy: rig injects RIG_IMAGE_REGISTRY + RIG_IMAGE_TAG fleet-wide (e.g. tag jp7); honor both
# so the image we PULL matches what `rig build` pushed (it tags with vehicle.yaml images.tag). The binary
# is arch-agnostic -- the tag is just the fleet deployment label (one coherent tag per vehicle). arm64 is
# only the standalone fallback.
DASH_REGISTRY="${DASH_REGISTRY:-${RIG_IMAGE_REGISTRY:-}}"
if [ -n "${DASH_REGISTRY:-}" ]; then
  TAG="${RIG_IMAGE_TAG:-${DASH_IMAGE_TAG:-arm64}}"
  export DASH_ZENOH_IMAGE="${DASH_ZENOH_IMAGE:-$DASH_REGISTRY/dashboard-zenoh:$TAG}"
  export DASH_WEB_IMAGE="${DASH_WEB_IMAGE:-$DASH_REGISTRY/dashboard-web:$TAG}"
fi

# Optional clouds mount (Clouds tab): only when the config set clouds_dir. Relative paths resolve
# against the CONFIG's directory (the config travels with its data on a vehicle).
OVERLAYS=(-f "$REPO/deploy/docker-compose.external-config.yml")
if [ -n "${DASH_CLOUDS_HOST:-}" ]; then
  case "$DASH_CLOUDS_HOST" in
    /*) : ;;
    *) DASH_CLOUDS_HOST="$(cd "$(dirname "$CONFIG_ABS")" && pwd)/$DASH_CLOUDS_HOST" ;;
  esac
  export DASH_CLOUDS_HOST
  OVERLAYS+=(-f "$REPO/deploy/docker-compose.clouds.yml")
fi

# The rig run registry, served read-only at /rig-data/ (Rig tab run browser + downloads, Clouds tab)
# whenever its data_dir is known: `rig_data_dir:` in the config, else RIG_DATA_DIR, which rig exports
# to every launcher -- so under rig this is on by default, agent or not (static files need no agent).
# Relative paths resolve against the CONFIG's directory.
DASH_RIG_DATA="${DASH_RIG_DATA:-${RIG_DATA_DIR:-}}"
if [ -n "$DASH_RIG_DATA" ]; then
  case "$DASH_RIG_DATA" in /*) : ;; *) DASH_RIG_DATA="$(cd "$(dirname "$CONFIG_ABS")" && pwd)/$DASH_RIG_DATA" ;; esac
  export DASH_RIG_DATA
  OVERLAYS+=(-f "$REPO/deploy/docker-compose.rig-data-web.yml")
fi

# Optional rig agent (Rig tab, docs/RIG_AGENT.md): only when the config set `rig_agent: true`. The
# agent drives `rig` for the whole deployment, so it needs the deployment TREE at its host path
# (identity mounts: rig hands docker compose host paths), the docker socket, and — for runs — the
# registry's data_dir. rig invokes us with a config path INSIDE the tree, so the tree is found by
# walking up to the nearest vehicle.yaml; `rig_root:` overrides. `rig_mount:` widens the read-only
# mount (a dev catalog's `../sibling` checkouts); `rig_data_dir:` overrides rig's RIG_DATA_DIR.
RIG_STATUS=""
if [ "${DASH_RIG_AGENT:-0}" = 1 ]; then
  RIG_ROOT_HOST="${DASH_RIG_ROOT:-}"
  if [ -z "$RIG_ROOT_HOST" ]; then
    d="$(dirname "$CONFIG_ABS")"
    while [ "$d" != / ] && [ ! -f "$d/vehicle.yaml" ]; do d="$(dirname "$d")"; done
    [ -f "$d/vehicle.yaml" ] && RIG_ROOT_HOST="$d"
  fi
  if [ -z "$RIG_ROOT_HOST" ]; then
    echo "dash-up: rig_agent: true but no vehicle.yaml above $CONFIG_ABS — set rig_root: (agent skipped)" >&2
  else
    case "$RIG_ROOT_HOST" in /*) : ;; *) RIG_ROOT_HOST="$(cd "$(dirname "$CONFIG_ABS")" && pwd)/$RIG_ROOT_HOST" ;; esac
    RIG_ROOT_HOST="$(cd "$RIG_ROOT_HOST" && pwd)"
    export DASH_RIG_ROOT="$RIG_ROOT_HOST"
    case "${DASH_RIG_MOUNT:-}" in
      "") DASH_RIG_MOUNT="$RIG_ROOT_HOST" ;;
      /*) : ;;
      *) DASH_RIG_MOUNT="$(cd "$(dirname "$CONFIG_ABS")" && pwd)/$DASH_RIG_MOUNT" ;;
    esac
    export DASH_RIG_MOUNT="$(cd "$DASH_RIG_MOUNT" && pwd)"
    local_f="${RIG_VEHICLE_LOCAL:-/etc/rig/vehicle.local.yaml}"
    [ -f "$local_f" ] && export DASH_RIG_LOCAL="$local_f"
    # The agent's state dir (job records) lives under the tree's var/ — create it as the OPERATOR
    # before docker can create it root-owned; on Linux run the agent as this uid so everything rig
    # writes (var/rendered, run manifests) stays operator-owned.
    mkdir -p "$RIG_ROOT_HOST/var/dashboard-rig-agent/home"
    if [ "$(uname -s)" = Linux ] && [ -S /var/run/docker.sock ]; then
      export DASH_AGENT_USER="${DASH_AGENT_USER:-$(id -u):$(id -g)}"
      export DASH_DOCKER_GID="${DASH_DOCKER_GID:-$(stat -c %g /var/run/docker.sock)}"
    fi
    if [ -n "${DASH_REGISTRY:-}" ]; then
      export DASH_AGENT_IMAGE="${DASH_AGENT_IMAGE:-$DASH_REGISTRY/dashboard-rig-agent:$TAG}"
    fi
    OVERLAYS+=(-f "$REPO/deploy/docker-compose.rig-agent.yml")
    # the agent's own read-write mount of the registry (resolved above, shared with the web mount)
    [ -n "$DASH_RIG_DATA" ] && OVERLAYS+=(-f "$REPO/deploy/docker-compose.rig-data.yml")
    RIG_STATUS=" agent=on root=$RIG_ROOT_HOST"
  fi
fi

ARGS=("$@"); [ ${#ARGS[@]} -eq 0 ] && ARGS=(up)
echo "dash-up: project=$COMPOSE_PROJECT_NAME web=:${DASH_WEB_PORT:-8080} ws=:${DASH_WS_PORT:-10000}${DASH_REGISTRY:+ registry=$DASH_REGISTRY}${DASH_RIG_DATA:+ data=$DASH_RIG_DATA}$RIG_STATUS config=$CONFIG_ABS" >&2
exec docker compose -f "$COMPOSE" "${OVERLAYS[@]}" "${ARGS[@]}"
