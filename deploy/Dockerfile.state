# dashboard-state (docs/VEHICLE_STATE.md): the vehicle side of vehicle state, bundled from the same
# TypeScript as the browser app (app/src/vstate) into one Node file. Node 22 provides the WebSocket
# client zenoh-ts needs; app/scripts/build-state.mjs inlines zenoh-ts's WebAssembly. Only sharp,
# a native module for image frames, is installed beside it.
#
# Build context = the REPO ROOT (needs app/). build-images.sh / compose set that.
FROM node:22-alpine AS build
WORKDIR /app
COPY app/package.json app/package-lock.json ./
COPY app/patches/ ./patches/
RUN npm ci
COPY app/ ./
RUN npm run typecheck && npm run build:state

FROM node:22-alpine
WORKDIR /srv
# Image frames encode with sharp (libvips), loaded at runtime: the exact version app/package.json
# pins, installed for this image's platform (prebuilt @img/sharp-linuxmusl-* binaries).
COPY --from=build /app/dist-state/package.json /srv/package.json
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist-state/dashboard-state.mjs /srv/dashboard-state.mjs
USER node
ENTRYPOINT ["node", "/srv/dashboard-state.mjs"]
