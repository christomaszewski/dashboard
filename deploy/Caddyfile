# Static file server for the dashboard bundle, plus the runtime instance config.
:{$DASH_WEB_PORT:8080} {
	encode gzip

	# The instance config YAML dash-up bind-mounts at /config/dashboard.yaml (see
	# docker-compose.external-config.yml). Its own handle block so a MISSING config is a clean 404
	# (the app's "no config → default Home" signal) instead of the SPA fallback's 200 index.html.
	# no-store: operators edit-and-refresh this file.
	handle /config/* {
		root * /
		header Cache-Control no-store
		file_server
	}

	# Point-cloud files for the Clouds tab (dash-up mounts them when the instance YAML sets
	# `clouds_dir:` — docker-compose.clouds.yml). `browse` = human listing AND JSON on
	# Accept: application/json, which is how the app lists the files. Absent mount → 404, and the
	# tab quietly hides its vehicle-files section.
	handle_path /clouds/* {
		root * /clouds
		file_server browse
	}

	# SPA fallback so client-side routes resolve to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
