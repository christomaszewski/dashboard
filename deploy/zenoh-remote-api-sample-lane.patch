+
+//! Vehicle dashboard patch: subscriber samples ride a bounded lane, apart from replies,
+//! acknowledgements and liveliness. Upstream queues everything for a WebSocket client in one
+//! unbounded channel, so a client on a slow link made the bridge buffer without limit (one raw
+//! camera over 128 kbit/s: +16 MB/s) and its own requests waited behind the backlog. Here a client
+//! that falls behind loses its OLDEST samples first — a viewer wants the newest value — while every
+//! control message still arrives, ahead of any queued sample.
+
+use std::sync::{
+    atomic::{AtomicU64, AtomicUsize, Ordering},
+    Arc,
+};
+
+use flume::{Receiver, Sender, TrySendError};
+
+use crate::{OutRemoteMessage, SequenceId};
+
+pub(crate) type LaneItem = (OutRemoteMessage, Option<SequenceId>, usize);
+
+fn env_usize(name: &str, default: usize) -> usize {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.trim().parse::<usize>().ok())
+        .filter(|v| *v > 0)
+        .unwrap_or(default)
+}
+
+#[derive(Clone)]
+pub(crate) struct SampleLane {
+    tx: Sender<LaneItem>,
+    /// A clone of the writer's receiver: lets the producer discard the oldest queued sample.
+    oldest: Receiver<LaneItem>,
+    bytes: Arc<AtomicUsize>,
+    dropped: Arc<AtomicU64>,
+    max_bytes: usize,
+}
+
+impl SampleLane {
+    /// The lane and the writer's end. Limits per WebSocket client:
+    /// ZENOH_REMOTE_API_SAMPLE_QUEUE_MESSAGES (default 1024) and
+    /// ZENOH_REMOTE_API_SAMPLE_QUEUE_BYTES (default 8 MiB; one larger sample still passes alone).
+    pub(crate) fn new() -> (Self, Receiver<LaneItem>) {
+        let max_messages = env_usize("ZENOH_REMOTE_API_SAMPLE_QUEUE_MESSAGES", 1024);
+        let max_bytes = env_usize("ZENOH_REMOTE_API_SAMPLE_QUEUE_BYTES", 8 * 1024 * 1024);
+        let (tx, rx) = flume::bounded(max_messages);
+        let lane = Self {
+            tx,
+            oldest: rx.clone(),
+            bytes: Arc::new(AtomicUsize::new(0)),
+            dropped: Arc::new(AtomicU64::new(0)),
+            max_bytes,
+        };
+        (lane, rx)
+    }
+
+    /// Queue a sample of `size` payload bytes, discarding the oldest queued ones to make room.
+    pub(crate) fn push(&self, msg: OutRemoteMessage, size: usize) {
+        while self.bytes.load(Ordering::Relaxed) + size > self.max_bytes {
+            match self.oldest.try_recv() {
+                Ok((_, _, s)) => self.discard(s),
+                Err(_) => break, // empty: a sample larger than the budget still goes alone
+            }
+        }
+        let mut item = (msg, None, size);
+        loop {
+            match self.tx.try_send(item) {
+                Ok(()) => {
+                    self.bytes.fetch_add(size, Ordering::Relaxed);
+                    return;
+                }
+                Err(TrySendError::Full(back)) => {
+                    item = back;
+                    if let Ok((_, _, s)) = self.oldest.try_recv() {
+                        self.discard(s);
+                    }
+                }
+                Err(TrySendError::Disconnected(_)) => return,
+            }
+        }
+    }
+
+    /// The writer took a sample of `size` bytes off the lane.
+    pub(crate) fn taken(&self, size: usize) {
+        self.bytes.fetch_sub(size, Ordering::Relaxed);
+    }
+
+    fn discard(&self, size: usize) {
+        self.bytes.fetch_sub(size, Ordering::Relaxed);
+        let n = self.dropped.fetch_add(1, Ordering::Relaxed) + 1;
+        if n == 1 || n % 1000 == 0 {
+            tracing::warn!("remote-api client cannot keep up: {n} stale samples dropped so far");
+        }
+    }
+}
